<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TowerDefense.ViewModels"
             x:Class="TowerDefense.LeaderboardPage"
             x:DataType="vm:LeaderboardViewModel"
             BackgroundColor="{DynamicResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <Grid Padding="16"
          RowDefinitions="Auto,*"
          RowSpacing="12">

        <!-- Ülariba: tagasi nupp, pealkiri ja "Kustuta kõik" -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Grid.Column="0"
                    Text="{Binding BackText}"
                    BackgroundColor="{DynamicResource CardColor}"
                    TextColor="{DynamicResource PrimaryText}"
                    CornerRadius="10"
                    Clicked="OnBackClicked" />

            <Label Grid.Column="1"
                   Text="{Binding TitleText}"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalTextAlignment="Center"
                   TextColor="{DynamicResource PrimaryText}" />

            <Button Grid.Column="2"
                    Text="{Binding ClearAllText}"
                    IsVisible="{Binding HasRows}"
                    FontSize="12"
                    BackgroundColor="{DynamicResource CardColor}"
                    TextColor="{DynamicResource PrimaryText}"
                    CornerRadius="10"
                    Clicked="OnClearAllClicked" />
        </Grid>

        <!-- Tulemuste loend -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Rows}"
                        IsVisible="{Binding HasRows}">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LeaderboardRow">
                    <Border BackgroundColor="{DynamicResource CardColor}"
                            Stroke="Transparent"
                            Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="48,*,Auto,Auto"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="8">

                            <Label Grid.Column="0"
                                   Grid.RowSpan="2"
                                   Text="{Binding RankText}"
                                   FontSize="22"
                                   VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{DynamicResource AccentColor}" />

                            <Label Grid.Column="1"
                                   Grid.Row="0"
                                   Text="{Binding Name}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{DynamicResource PrimaryText}" />

                            <Label Grid.Column="1"
                                   Grid.Row="1"
                                   Text="{Binding DetailText}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   TextColor="{DynamicResource PrimaryText}" />

                            <Label Grid.Column="2"
                                   Grid.Row="0"
                                   Text="{Binding ScoreText}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="End"
                                   TextColor="{DynamicResource PrimaryText}" />

                            <Label Grid.Column="2"
                                   Grid.Row="1"
                                   Text="{Binding WaveText}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   HorizontalTextAlignment="End"
                                   TextColor="{DynamicResource PrimaryText}" />

                            <!-- Ühe tulemuse kustutamine -->
                            <Button Grid.Column="3"
                                    Grid.RowSpan="2"
                                    Text="🗑"
                                    FontSize="18"
                                    Padding="0"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    VerticalOptions="Center"
                                    BackgroundColor="Transparent"
                                    Clicked="OnDeleteClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Kui tulemusi pole -->
        <Label Grid.Row="1"
               Text="{Binding EmptyText}"
               IsVisible="{Binding IsEmpty}"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               FontSize="16"
               TextColor="{DynamicResource PrimaryText}" />
    </Grid>
</ContentPage>