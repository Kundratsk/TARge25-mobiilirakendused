<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TowerDefense.ViewModels"
             x:Class="TowerDefense.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Tower Defense"
             BackgroundColor="{DynamicResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Ühine stiil kõigile ikooninuppudele -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="MinimumWidthRequest" Value="44" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BackgroundColor" Value="{DynamicResource CardColor}" />
            <Setter Property="TextColor" Value="{DynamicResource PrimaryText}" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="6"
          RowDefinitions="Auto,*"
          RowSpacing="4">

        <!-- Ülemine statistika -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,*,*,*,Auto"
              ColumnSpacing="4">

            <Label Grid.Column="0"
                   Text="{Binding LivesText}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   FontSize="14"
                   TextColor="{DynamicResource PrimaryText}" />

            <Label Grid.Column="1"
                   Text="{Binding MoneyText}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   FontSize="14"
                   TextColor="{DynamicResource PrimaryText}" />

            <Label Grid.Column="2"
                   Text="{Binding ScoreText}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   FontSize="14"
                   TextColor="{DynamicResource PrimaryText}" />

            <Label Grid.Column="3"
                   Text="{Binding WaveText}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   FontSize="14"
                   TextColor="{DynamicResource PrimaryText}" />

            <Picker x:Name="ThemePicker"
                    Grid.Column="4"
                    Title="🎨"
                    WidthRequest="48"
                    FontSize="12"
                    TextColor="{DynamicResource PrimaryText}"
                    TitleColor="{DynamicResource PrimaryText}"
                    SelectedIndexChanged="OnThemeChanged" />
        </Grid>

        <!-- Suur mängulaud ja väike ikooniriba -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,44"
              ColumnSpacing="3">

            <!-- Mängulaud -->
            <Grid Grid.Column="0"
                  RowDefinitions="Auto,*"
                  RowSpacing="2">

                <Label Grid.Row="0"
                       Text="{Binding StatusText}"
                       FontSize="12"
                       MaxLines="2"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{DynamicResource PrimaryText}" />

                <GraphicsView x:Name="BoardView"
                              Grid.Row="1"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill">

                    <GraphicsView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBoardTapped" />
                    </GraphicsView.GestureRecognizers>

                </GraphicsView>
            </Grid>

            <!-- Väikesed ikooninupud -->
            <Grid Grid.Column="1"
                  RowDefinitions="*,Auto,Auto,Auto,*,Auto,Auto,*"
                  RowSpacing="6">

                <!-- Valitud torni nupp muutub esiletõstetuks DataTrigger'i abil -->
                <Button Grid.Row="1"
                        Text="🏹"
                        Style="{StaticResource IconButton}"
                        Command="{Binding SelectArcherCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsArcherSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBackground}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Grid.Row="2"
                        Text="💣"
                        Style="{StaticResource IconButton}"
                        Command="{Binding SelectCannonCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsCannonSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBackground}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Grid.Row="3"
                        Text="🧙"
                        Style="{StaticResource IconButton}"
                        Command="{Binding SelectMageCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsMageSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBackground}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Grid.Row="5"
                        Text="{Binding StartButtonText}"
                        Style="{StaticResource IconButton}"
                        BackgroundColor="{DynamicResource AccentColor}"
                        TextColor="{DynamicResource PageBackground}"
                        Command="{Binding StartPauseCommand}" />

                <Button Grid.Row="6"
                        Text="💰"
                        Style="{StaticResource IconButton}"
                        Command="{Binding ToggleSellCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsSellMode}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBackground}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </Grid>
        </Grid>
    </Grid>

</ContentPage>