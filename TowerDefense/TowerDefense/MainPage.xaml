<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TowerDefense.MainPage"
             Title="Tower Defense"
             BackgroundColor="{DynamicResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="10" RowSpacing="8">

        <!-- Statistika -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*, auto">
            <Label x:Name="LivesLabel" Grid.Column="0" HorizontalTextAlignment="Center" FontSize="16"
                   TextColor="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" />
            <Label x:Name="MoneyLabel" Grid.Column="1" HorizontalTextAlignment="Center" FontSize="16"
                   TextColor="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" />
            <Label x:Name="ScoreLabel" Grid.Column="2" HorizontalTextAlignment="Center" FontSize="16"
                   TextColor="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" />
            <Label x:Name="WaveLabel" Grid.Column="3" HorizontalTextAlignment="Center" FontSize="16"
                   TextColor="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" />
            <Picker x:Name="ThemePicker" Grid.Column="4" Title=""
                        TextColor="{DynamicResource PrimaryText}"
                        TitleColor="{DynamicResource PrimaryText}"
                        FontFamily="{DynamicResource AppFont}"
                        SelectedIndexChanged="OnThemeChanged" />
        </Grid>

        <!-- Teade -->
        <Label x:Name="StatusLabel" Grid.Row="1" HorizontalTextAlignment="Center" FontSize="14"
               Text="Vali torn ja puuduta ruutu, et see paigutada."
               TextColor="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" />

        <!-- Mänguväli -->
        <GraphicsView x:Name="BoardView" Grid.Row="2">
            <GraphicsView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBoardTapped" />
            </GraphicsView.GestureRecognizers>
        </GraphicsView>

        <!-- Tornide valik -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button x:Name="ArcherButton" Grid.Column="0" Text="🏹 Vibukütt (50)"
                    FontFamily="{DynamicResource AppFont}" Clicked="OnArcherClicked" />
            <Button x:Name="CannonButton" Grid.Column="1" Text="💣 Kahur (120)"
                    FontFamily="{DynamicResource AppFont}" Clicked="OnCannonClicked" />
        </Grid>


        <!-- Juhtimine -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button x:Name="StartButton" Grid.Column="0" Text="▶ Start"
                    FontFamily="{DynamicResource AppFont}" Clicked="OnStartClicked" />
            <Button x:Name="SellButton" Grid.Column="1" Text="💰 Müü"
                    FontFamily="{DynamicResource AppFont}" Clicked="OnSellClicked" />
        </Grid>


    </Grid>

</ContentPage>
