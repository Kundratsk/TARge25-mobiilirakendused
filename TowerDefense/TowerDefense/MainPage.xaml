<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TowerDefense.ViewModels"
             x:Class="TowerDefense.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Tower Defense"
             BackgroundColor="{DynamicResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Ühine stiil kõigile ikooninuppudele -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="MinimumWidthRequest" Value="44" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="6"
          RowDefinitions="Auto,*"
          RowSpacing="4">

        <!-- Ülemine statistika -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,*,*,*,*"
              ColumnSpacing="4">

            <Label Grid.Column="0"
                   Text="{Binding LivesText}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   FontSize="14"
                   TextColor="{DynamicResource PrimaryText}" />

            <Label Grid.Column="1"
                   Text="{Binding MoneyText}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   FontSize="14"
                   TextColor="{DynamicResource PrimaryText}" />

            <Label Grid.Column="2"
                   Text="{Binding ScoreText}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   FontSize="14"
                   TextColor="{DynamicResource PrimaryText}" />

            <Label Grid.Column="3"
                   Text="{Binding WaveText}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   FontSize="14"
                   TextColor="{DynamicResource PrimaryText}" />

            <!-- Parim tulemus; vajutus avab edetabeli -->
            <Label Grid.Column="4"
                   Text="{Binding BestScoreText, StringFormat='🏆 {0}'}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource AccentColor}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLeaderboardTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Suur mängulaud ja väike ikooniriba -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,44"
              ColumnSpacing="3">

            <!-- Mängulaud -->
            <Grid Grid.Column="0"
                  RowDefinitions="Auto,*"
                  RowSpacing="2">

                <Label Grid.Row="0"
                       Text="{Binding StatusText}"
                       FontSize="12"
                       MaxLines="2"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{DynamicResource PrimaryText}" />

                <GraphicsView x:Name="BoardView"
                              Grid.Row="1"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill">

                    <GraphicsView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBoardTapped" />
                    </GraphicsView.GestureRecognizers>

                </GraphicsView>
            </Grid>

            <!-- Väikesed ikooninupud (valikunuppude värvid seab MainPage.xaml.cs -> UpdateButtons) -->
            <Grid Grid.Column="1"
                  RowDefinitions="*,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,*"
                  RowSpacing="6">

                <Button x:Name="ArcherButton"
                        Grid.Row="1"
                        Text="🏹"
                        Style="{StaticResource IconButton}"
                        Command="{Binding SelectArcherCommand}" />

                <Button x:Name="CannonButton"
                        Grid.Row="2"
                        Text="💣"
                        Style="{StaticResource IconButton}"
                        Command="{Binding SelectCannonCommand}" />

                <Button x:Name="MageButton"
                        Grid.Row="3"
                        Text="🧙"
                        Style="{StaticResource IconButton}"
                        Command="{Binding SelectMageCommand}" />

                <Button x:Name="StartButton"
                        Grid.Row="5"
                        Text="{Binding StartButtonText}"
                        Style="{StaticResource IconButton}"
                        BackgroundColor="{DynamicResource AccentColor}"
                        TextColor="{DynamicResource PageBackground}"
                        Command="{Binding StartPauseCommand}" />

                <Button x:Name="SellButton"
                        Grid.Row="6"
                        Text="💰"
                        Style="{StaticResource IconButton}"
                        Command="{Binding ToggleSellCommand}" />

                <!-- Uuesti alustamise nupp (küsib enne kinnitust) -->
                <Button x:Name="ResetButton"
                        Grid.Row="7"
                        Text="🔄"
                        Style="{StaticResource IconButton}"
                        BackgroundColor="{DynamicResource CardColor}"
                        TextColor="{DynamicResource PrimaryText}"
                        Command="{Binding ResetGameCommand}" />

                <!-- Seadete leht -->
                <Button x:Name="SettingsButton"
                        Grid.Row="8"
                        Text="⚙️"
                        Style="{StaticResource IconButton}"
                        BackgroundColor="{DynamicResource CardColor}"
                        TextColor="{DynamicResource PrimaryText}"
                        Clicked="OnSettingsClicked" />

            </Grid>
        </Grid>
    </Grid>

</ContentPage>