<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Valgusfoor.MainPage">

    <Grid>

        <!-- LINNATÄNAV TAUSTAL -->
        <Image
            Source="linnatanav.jpg"
            Aspect="AspectFill" />

        <!-- Tume kiht pildi peal, et tekst oleks paremini nähtav -->
        <BoxView
            Color="Black"
            Opacity="0.25" />

        <!-- FOOR -->
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                x:Name="StatusLabel"
                Text="Vali valgus"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="White" />

            <!-- PUNANE -->
            <Border
                x:Name="RedLight"
                WidthRequest="120"
                HeightRequest="120"
                BackgroundColor="Gray"
                HorizontalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="60" />
                </Border.StrokeShape>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRedClicked" />
                </Border.GestureRecognizers>

            </Border>

            <!-- KOLLANE -->
            <Border
                x:Name="YellowLight"
                WidthRequest="120"
                HeightRequest="120"
                BackgroundColor="Gray"
                HorizontalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="60" />
                </Border.StrokeShape>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnYellowClicked" />
                </Border.GestureRecognizers>

            </Border>

            <!-- ROHELINE -->
            <Border
                x:Name="GreenLight"
                WidthRequest="120"
                HeightRequest="120"
                BackgroundColor="Gray"
                HorizontalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="60" />
                </Border.StrokeShape>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGreenClicked" />
                </Border.GestureRecognizers>

            </Border>

            <!-- NUPUD -->
            <HorizontalStackLayout
                Spacing="20"
                HorizontalOptions="Center">

                <Button
                    Text="Sisse"
                    Clicked="OnOnClicked"
                    WidthRequest="120" />

                <Button
                    Text="Välja"
                    Clicked="OnOffClicked"
                    WidthRequest="120" />

            </HorizontalStackLayout>
            <Button
                Text="Automaatreziim"
                Clicked="AutomaatRegime"
                WidthRequest="200"
                />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
