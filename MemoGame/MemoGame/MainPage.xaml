<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#121526"
             x:Class="MemoGame.MainPage"
             Title="MemoGame">


    <ContentPage.Resources>
        <Color x:Key="TextColor">White</Color>
        <Color x:Key="CardColor">#303858</Color>
        <x:String x:Key="AppFont">OpenSansRegular</x:String>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="24,30"
            Spacing="22">

            <!-- Teema valik -->
            <Picker
                x:Name="ThemePicker"
                Title="Vali teema"
                TextColor="{DynamicResource TextColor}"
                TitleColor="{DynamicResource TextColor}"
                FontFamily="{DynamicResource AppFont}"
                HorizontalOptions="End"
                WidthRequest="150"
                SelectedIndexChanged="OnThemeChanged"/>

            <!-- Pealkiri -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="MEMO GAME"
                    FontSize="14"
                    CharacterSpacing="4"
                    TextColor="#A78BFA"
                    FontFamily="{DynamicResource AppFont}"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"/>

                <Label
                    Text="Treeni oma mälu!"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextColor}"
                    FontFamily="{DynamicResource AppFont}"
                    HorizontalOptions="Center"/>

                <Label
                    Text="Leia kõik sobivad kaardipaarid."
                    FontSize="14"
                    TextColor="{DynamicResource TextColor}"
                    FontFamily="{DynamicResource AppFont}"
                    Opacity="0.7"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Tulemused -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">

                <Border
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    Stroke="#66888888"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="KÄIGUD"
                            FontSize="12"
                            TextColor="{DynamicResource TextColor}"
                            FontFamily="{DynamicResource AppFont}"
                            Opacity="0.7"
                            HorizontalOptions="Center"/>

                        <Label
                            x:Name="MovesLabel"
                            Text="0"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextColor}"
                            FontFamily="{DynamicResource AppFont}"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    BackgroundColor="Transparent"
                    Stroke="#66888888"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="LEITUD PAARID"
                            FontSize="12"
                            TextColor="{DynamicResource TextColor}"
                            FontFamily="{DynamicResource AppFont}"
                            Opacity="0.7"
                            HorizontalOptions="Center"/>

                        <Label
                            x:Name="PairsLabel"
                            Text="0 / 8"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="#A78BFA"
                            FontFamily="{DynamicResource AppFont}"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Mängulaud -->
            <Border
                BackgroundColor="Transparent"
                Stroke="#66888888"
                StrokeThickness="1"
                Padding="12"
                StrokeShape="RoundRectangle 22"
                >

                <Grid
                    x:Name="GameGrid"
                    RowDefinitions="*,*,*,*"
                    ColumnDefinitions="*,*,*,*"
                    RowSpacing="9"
                    ColumnSpacing="9"
                    HeightRequest="330">

                    <!-- Kaardid luuakse MainPage.xaml.cs failis -->
                </Grid>
            </Border>

            <!-- Teade -->
            <Label
                x:Name="StatusLabel"
                Text="Vali kaks kaarti ja leia paar!"
                FontSize="14"
                TextColor="{DynamicResource TextColor}"
                FontFamily="{DynamicResource AppFont}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"/>

            <!-- Uus mäng -->
            <Button
                x:Name="NewGameButton"
                Text="↻   UUS MÄNG"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="#7C5CFC"
                FontFamily="{DynamicResource AppFont}"
                CornerRadius="16"
                HeightRequest="56"
                Clicked="OnNewGameClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
