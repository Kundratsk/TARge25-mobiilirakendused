<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TARge25MAUI.TimerPage"
             Title="TimerPage">

    <ContentPage.Content>
        <VerticalStackLayout Padding="20" Spacing="20">
            <FlexLayout Direction="Column" AlignItems="Center" JustifyContent="Center">
                <Label x:Name="lbl"
                       Text="Kellaaeg"
                       FontSize="Large"
                       BackgroundColor="White"
                       Padding="20">
                       
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_tappede"/>
                    </Label.GestureRecognizers>
                </Label>

                <Button x:Name="timer_btn"
                        Text="Näita info"
                        FontSize="Large"
                        Clicked="timer_btn_Clicked">
                    
                </Button>
            </FlexLayout>

            <Button x:Name="tagasi"
                    Text="Tagasi"
                    FontSize="Large"
                    Clicked="tagasi_Clicked">
            </Button>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>
