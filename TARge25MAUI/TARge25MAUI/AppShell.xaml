    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TARge25MAUI"
    Title="TARge25MAUI">

    <Shell.TitleView>
        <Label 
            Text="Näidis"
            FontFamily="luffio Regular 400"
